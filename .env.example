# ===== IMAP (đọc mail) =====
IMAP_HOST=imap.example.com
IMAP_PORT=993
# tls (implicit TLS/993) | starttls (143) | plain
IMAP_MODE=tls
IMAP_SKIP_VERIFY=false

# ===== SMTP (gửi mail) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (587) | tls (465) | plain
SMTP_MODE=starttls
# Để trống nếu SMTP dùng cùng tài khoản/mật khẩu với IMAP (đăng nhập trên UI)
SMTP_USER=
SMTP_PASS=
# Để trống nếu địa chỉ gửi = tài khoản đăng nhập
SMTP_FROM=
SMTP_SKIP_VERIFY=false

# ===== Webmail =====
HTTP_ADDR=:8080
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài (>= 32 ký tự) khi chạy thật,
# dùng để mã hoá phiên đăng nhập trong cookie
APP_SECRET=change-me-to-a-long-random-secret-string
SESSION_HOURS=24

# Hộp thư lưu bản sao thư đã gửi / thùng rác
MAILBOX_SENT=Sent
MAILBOX_TRASH=Trash
